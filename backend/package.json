{
  "name": "@paygrid/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "node --test --import tsx src/__tests__/*.test.ts",
    "indexer": "tsx src/indexer.ts",
    "indexer:start": "node dist/indexer.js",
    "treasury:worker": "tsx src/treasury-worker.ts",
    "treasury:worker:start": "node dist/treasury-worker.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "ripio:preflight": "tsx scripts/ripio-preflight.ts",
    "ripio:mock-smoke": "tsx scripts/ripio-mock-smoke.ts",
    "odeleite:preflight": "tsx scripts/odeleite-preflight.ts",
    "x402:preflight": "node --import tsx src/x402-preflight.ts",
    "x402:worker": "node --import tsx src/x402-worker.ts",
    "x402:worker:start": "node dist/x402-worker.js",
    "typecheck": "tsc --noEmit",
    "x402:setup": "node --import tsx src/x402-setup.ts",
    "x402:fork": "node --import tsx src/x402-fork-check.ts",
    "x402:canary": "node --import tsx src/x402-canary.ts",
    "x402:db-check": "node scripts/x402-db-check.mjs"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.3.0",
    "@hono/node-server": "2.1.11",
    "@mento-protocol/mento-sdk": "^3.2.8",
    "@privy-io/node": "^0.19.0",
    "@supabase/supabase-js": "^2.49.4",
    "@x402/core": "2.32.0",
    "@x402/evm": "2.32.0",
    "@x402/extensions": "2.32.0",
    "@x402/fetch": "2.32.0",
    "@x402/hono": "2.32.0",
    "dotenv": "^16.5.0",
    "hono": "4.13.22",
    "ipaddr.js": "2.3.0",
    "undici": "7.30.2",
    "viem": "^2.29.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@types/node": "^22.15.3",
    "postgres": "^3.4.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
