# Copy through npm run x402:setup to create dedicated secrets securely.
# Flags stay off until migration, preflight, Sepolia and mainnet canaries pass.
X402_SELLER_ENABLED=false
X402_PAYER_ENABLED=false
X402_API_KEY=
X402_PAY_TO=
X402_PAYER_ADDRESS=
X402_PAYER_PRIVATE_KEY=
X402_EXECUTOR_API_KEY=
X402_ENCRYPTION_KEY=
X402_PUBLIC_API_URL=https://api.celopaygrid.xyz
# Atomic amounts, not floating-point prices. Override only explicitly.
X402_ASSET_CONFIG={"USDC":{"price":"100000","perPayment":"5000000","daily":"50000000"},"USDT":{"price":"100000","perPayment":"5000000","daily":"50000000"},"wMXN":{"price":"2000000000000000000","perPayment":"100000000000000000000","daily":"1000000000000000000000"}}
# Optional exact origins, paths, methods and receiving addresses. No wildcards.
# Without this variable, only GET /api/x402/data on X402_PUBLIC_API_URL is allowed.
# X402_MERCHANTS=[{"origin":"https://api.celopaygrid.xyz","paths":["/api/x402/data"],"methods":["GET"],"payTo":["0x..."]}]
